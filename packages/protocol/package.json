{
    "name": "@spinner/protocol",
    "version": "0.2.0",
    "private": true,
    "description": "Shared types and JSON schema for Spinner sessions, events and the daemon API.",
    "license": "MIT",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./schema/session.json": "./schema/session.json",
        "./schema/stack-spec.json": "./schema/stack-spec.json",
        "./schema/session-view.json": "./schema/session-view.json",
        "./schema/job.json": "./schema/job.json"
    },
    "files": [
        "dist",
        "schema"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run",
        "schema": "node scripts/generate-schema.ts"
    },
    "devDependencies": {
        "ajv": "^8.20.0",
        "ts-json-schema-generator": "^2.9.0",
        "typescript": "^5.9.0",
        "vitest": "^3.2.0",
        "yaml": "^2.9.1"
    }
}
