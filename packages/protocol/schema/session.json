{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$ref": "#/definitions/Session",
    "definitions": {
        "Session": {
            "type": "object",
            "properties": {
                "version": {
                    "type": "number",
                    "const": 1
                },
                "kind": {
                    "$ref": "#/definitions/SessionKind",
                    "description": "`review` for a review session (s015); absent means an ordinary session."
                },
                "id": {
                    "type": "string",
                    "description": "Short id, for example `s17`."
                },
                "slug": {
                    "type": "string",
                    "description": "URL-safe slug; the directory is `<id>-<slug>`."
                },
                "title": {
                    "type": "string"
                },
                "project": {
                    "type": "string",
                    "description": "Project name whose `spinner.yaml` configures the stack and the pipeline tracker."
                },
                "created": {
                    "type": "string",
                    "description": "ISO 8601 date or timestamp."
                },
                "stage": {
                    "$ref": "#/definitions/Stage"
                },
                "needs_human": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "The single next action for the operator, or null."
                },
                "branch": {
                    "type": "string"
                },
                "base": {
                    "type": "string"
                },
                "round": {
                    "type": "number",
                    "description": "Round number; 1 until the first `spinner reset`. Absent in files written before s005."
                },
                "repos": {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/definitions/SessionRepo"
                    }
                },
                "pipeline": {
                    "$ref": "#/definitions/Pipeline"
                },
                "stack": {
                    "$ref": "#/definitions/StackState"
                },
                "agents": {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/definitions/AgentSpec"
                    }
                },
                "diff": {
                    "$ref": "#/definitions/DiffState",
                    "description": "The diff viewers the daemon runs for this session (s012). Absent before the first start."
                },
                "review": {
                    "$ref": "#/definitions/ReviewState",
                    "description": "The review swarm (s015). Absent until the first `review`."
                },
                "design": {
                    "$ref": "#/definitions/DesignState",
                    "description": "Absent means a session from before the EGM design. `SESSION_VERSION` stays 1."
                },
                "rounds": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/RoundRecord"
                    },
                    "description": "Earlier rounds, oldest first, appended by `reset` since the EGM design. Rounds before that are only in `## Previous rounds` of MISSION.md."
                },
                "outcomes": {
                    "$ref": "#/definitions/OutcomeCounts",
                    "description": "Absent in sessions created before EGM build session 6."
                }
            },
            "required": [
                "version",
                "id",
                "slug",
                "title",
                "created",
                "stage",
                "needs_human",
                "branch",
                "base",
                "repos",
                "stack",
                "agents"
            ],
            "additionalProperties": false,
            "description": "The whole of `session.yaml`."
        },
        "SessionKind": {
            "type": "string",
            "enum": [
                "session",
                "review"
            ],
            "description": "What a session is (s015). `review` is a place for a peer's PR: a detached worktree at the PR head under `<home>/reviews/`, no project, no stack, and `review` as its one action."
        },
        "Stage": {
            "type": "string",
            "enum": [
                "planned",
                "building",
                "bot-review",
                "fixing",
                "verifying",
                "peer-review",
                "addressing",
                "approving",
                "queued",
                "merged",
                "closed"
            ]
        },
        "SessionRepo": {
            "type": "object",
            "properties": {
                "path": {
                    "type": "string",
                    "description": "Path of the repo on this machine. May start with `~` or be relative to the session."
                },
                "worktree": {
                    "type": "string",
                    "description": "Worktree path relative to the session directory. Absent for the bootstrap session."
                },
                "changed": {
                    "type": "boolean",
                    "description": "True when the session's branch has commits ahead of `base` in this repo."
                },
                "pr": {
                    "anyOf": [
                        {
                            "$ref": "#/definitions/PullRequest"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "The PR for this repo, or null when none has been opened."
                }
            },
            "required": [
                "path",
                "changed"
            ],
            "additionalProperties": false
        },
        "PullRequest": {
            "type": "object",
            "properties": {
                "number": {
                    "type": "number"
                },
                "url": {
                    "type": "string"
                },
                "author": {
                    "type": "string"
                },
                "state": {
                    "$ref": "#/definitions/PrState"
                },
                "head": {
                    "type": "string"
                },
                "checks": {
                    "$ref": "#/definitions/CheckState"
                },
                "approval_check": {
                    "$ref": "#/definitions/ApprovalCheckState"
                },
                "approvals": {
                    "$ref": "#/definitions/PrApprovals"
                },
                "threads": {
                    "$ref": "#/definitions/PrThreads"
                },
                "review": {
                    "$ref": "#/definitions/ReviewDecision"
                },
                "bot_reviewed_head": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Head SHA of the latest bot review, or null before the first one."
                },
                "queue": {
                    "$ref": "#/definitions/QueueState"
                },
                "queue_reason": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Why the merge queue removed the PR, from `RemovedFromMergeQueueEvent.reason`."
                },
                "last_activity": {
                    "type": "string",
                    "description": "ISO 8601 timestamp of the last activity on the PR."
                },
                "title": {
                    "type": "string",
                    "description": "PR title, as `gh pr create` set it or GitHub reports it. Absent before s005."
                },
                "checks_failing": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Names of the checks that are red, for the CI pill's tooltip (s015). Absent before s015."
                }
            },
            "required": [
                "number",
                "url",
                "author",
                "state",
                "head",
                "checks",
                "approval_check",
                "approvals",
                "threads",
                "review",
                "bot_reviewed_head",
                "queue",
                "last_activity"
            ],
            "additionalProperties": false
        },
        "PrState": {
            "type": "string",
            "enum": [
                "draft",
                "open",
                "merged",
                "closed"
            ]
        },
        "CheckState": {
            "type": "string",
            "enum": [
                "pending",
                "green",
                "red"
            ]
        },
        "ApprovalCheckState": {
            "type": "string",
            "enum": [
                "pending",
                "pass",
                "fail"
            ]
        },
        "PrApprovals": {
            "type": "object",
            "properties": {
                "required": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/ApprovalRole"
                    }
                },
                "peer": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Logins of peers who approved the current head."
                },
                "owner": {
                    "type": "boolean",
                    "description": "Whether the owner (the person named in `github.owner_login`) approved the current head."
                }
            },
            "required": [
                "required",
                "peer",
                "owner"
            ],
            "additionalProperties": false
        },
        "ApprovalRole": {
            "type": "string",
            "enum": [
                "peer",
                "owner"
            ]
        },
        "PrThreads": {
            "type": "object",
            "properties": {
                "bots_open": {
                    "type": "number"
                },
                "humans_open": {
                    "type": "number"
                },
                "resolved": {
                    "type": "number"
                },
                "flagged": {
                    "type": "number",
                    "description": "Open threads the fixer flagged for the operator. Absent in files written before s005."
                }
            },
            "required": [
                "bots_open",
                "humans_open",
                "resolved"
            ],
            "additionalProperties": false
        },
        "ReviewDecision": {
            "type": "string",
            "enum": [
                "none",
                "changes_requested",
                "approved"
            ]
        },
        "QueueState": {
            "type": "string",
            "enum": [
                "none",
                "queued",
                "popped",
                "merging"
            ]
        },
        "Pipeline": {
            "type": "object",
            "properties": {
                "verified_locally": {
                    "type": "boolean"
                },
                "verified_heads": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    },
                    "description": "Repo name to head SHA that the operator verified."
                },
                "verified_at": {
                    "type": "string",
                    "description": "When and by whom `spinner verify` recorded the tick. Absent until the first tick."
                },
                "verified_by": {
                    "type": "string"
                },
                "slack_post": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "reviewer": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "posted_at": {
                    "type": "string",
                    "description": "When `spinner post` sent the message. Absent until then."
                },
                "approved_heads": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    },
                    "description": "Repo name to head SHA the operator approved through `spinner approve`."
                },
                "slack_activity": {
                    "$ref": "#/definitions/SlackActivity",
                    "description": "Replies and reactions under the Slack post, as the daemon last polled them."
                }
            },
            "required": [
                "verified_locally",
                "slack_post"
            ],
            "additionalProperties": false,
            "description": "Pipeline facts. Hand-written files may omit `verified_heads` and `reviewer`; the daemon treats an absent field as empty and fills it in when it first writes the file."
        },
        "SlackActivity": {
            "type": "object",
            "properties": {
                "replies": {
                    "type": "number"
                },
                "reactions": {
                    "type": "number"
                },
                "last_activity": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "ISO 8601 time of the latest reply or reaction, or null when there is none."
                },
                "polled_at": {
                    "type": "string",
                    "description": "ISO 8601 time of the poll that produced these counts."
                }
            },
            "required": [
                "replies",
                "reactions",
                "last_activity",
                "polled_at"
            ],
            "additionalProperties": false,
            "description": "What the daemon reads under the session's Slack post. Read-only; counts drive the board."
        },
        "StackState": {
            "type": "object",
            "properties": {
                "project": {
                    "type": "string",
                    "description": "Docker compose project name, for example `spinner-s17`."
                },
                "state": {
                    "$ref": "#/definitions/StackStateName"
                },
                "hosts": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    },
                    "description": "Service name to hostname, for example `admin` to `admin.s17.localhost`."
                },
                "db": {
                    "type": "string",
                    "description": "Database name cloned from the seed template."
                },
                "db_stale": {
                    "type": "boolean",
                    "description": "The clone belongs to a previous round: `reset` ran while the stack was down and did not touch the server. The next `up` drops it before it clones."
                },
                "processes": {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/definitions/HostProcess"
                    },
                    "description": "Services with `runtime: host`, by name: the process Spinner started for them."
                },
                "last_job": {
                    "$ref": "#/definitions/StackLastJob",
                    "description": "The last `up`, `down` or `reset` job, so an agent can see why a stack failed."
                }
            },
            "required": [
                "state"
            ],
            "additionalProperties": false
        },
        "StackStateName": {
            "type": "string",
            "enum": [
                "none",
                "up",
                "down",
                "starting",
                "failed"
            ],
            "description": "Stack state, as the daemon observes it. `none` means the session has no stack."
        },
        "HostProcess": {
            "type": "object",
            "properties": {
                "pid": {
                    "type": "number"
                },
                "started": {
                    "type": "string",
                    "description": "The process start time as `ps` prints it. A pid is reused once its process exits; the start time tells Spinner's process from a stranger that inherited the number."
                },
                "port": {
                    "type": "number",
                    "description": "The port the service listens on; the proxy routes its hostname here."
                },
                "log": {
                    "type": "string",
                    "description": "Log file, relative to the session directory."
                }
            },
            "required": [
                "pid",
                "port",
                "log"
            ],
            "additionalProperties": false,
            "description": "A `runtime: host` service's process, as `spinner up` started it."
        },
        "StackLastJob": {
            "type": "object",
            "properties": {
                "action": {
                    "type": "string",
                    "enum": [
                        "up",
                        "down",
                        "reset"
                    ]
                },
                "state": {
                    "type": "string",
                    "enum": [
                        "ok",
                        "failed"
                    ]
                },
                "error": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "The error message of a failed job, else null."
                },
                "finished": {
                    "type": "string",
                    "description": "ISO 8601 time the job finished."
                },
                "tail": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "The last `STACK_JOB_TAIL_LINES` lines of the job's log."
                }
            },
            "required": [
                "action",
                "state",
                "error",
                "finished",
                "tail"
            ],
            "additionalProperties": false,
            "description": "How the last stack job ended. Written by the daemon when the job finishes."
        },
        "AgentSpec": {
            "type": "object",
            "properties": {
                "harness": {
                    "$ref": "#/definitions/AgentHarnessName"
                },
                "model": {
                    "type": "string"
                },
                "process": {
                    "$ref": "#/definitions/AgentProcessState"
                },
                "pid": {
                    "type": "number"
                },
                "started": {
                    "type": "string",
                    "description": "The process start time as `ps -o lstart=` prints it, so a restart can tell a reused pid."
                },
                "repo": {
                    "type": "string",
                    "description": "Repo key of `repos` whose worktree is the agent's cwd; the session dir when absent."
                },
                "skills": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Skill directories pi loads with `--skill`, beyond the session's `skills/` (s015)."
                }
            },
            "required": [
                "harness",
                "model",
                "process"
            ],
            "additionalProperties": false,
            "description": "One agent of a session: how it runs and whether its process is alive."
        },
        "AgentHarnessName": {
            "type": "string",
            "enum": [
                "tty",
                "rpc",
                "pi"
            ],
            "description": "How an agent's pi runs: `tty` is pi's own terminal UI in a pty, rendered by the agent tab over `GET /sessions/:dir/agents/:name/tty`; `rpc` is `pi --mode rpc`, the headless path. `pi` is the value files written before s009 carry; it reads as `rpc`."
        },
        "AgentProcessState": {
            "type": "string",
            "enum": [
                "running",
                "idle",
                "exited"
            ]
        },
        "DiffState": {
            "type": "object",
            "properties": {
                "repos": {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/definitions/HostProcess"
                    }
                },
                "threads": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/DiffThreadRecord"
                    },
                    "description": "The unresolved comment threads of every running viewer, from the watcher's last `diffview comments list --json`. The view counts them and the stage derivation turns the ones waiting on the operator into `needs_human`."
                }
            },
            "required": [
                "repos"
            ],
            "additionalProperties": false,
            "description": "One `diffview` process per repo, by repo key, while it runs. Reattached by pid identity."
        },
        "DiffThreadRecord": {
            "type": "object",
            "properties": {
                "repo": {
                    "type": "string"
                },
                "thread": {
                    "type": "number"
                },
                "waiting_on": {
                    "type": "string",
                    "enum": [
                        "agent",
                        "human"
                    ]
                },
                "path": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "The file, or null for a thread on the whole branch or on a description."
                },
                "start_line": {
                    "type": [
                        "number",
                        "null"
                    ]
                },
                "end_line": {
                    "type": [
                        "number",
                        "null"
                    ]
                }
            },
            "required": [
                "repo",
                "thread",
                "waiting_on",
                "path",
                "start_line",
                "end_line"
            ],
            "additionalProperties": false,
            "description": "One unresolved thread, as much of it as `needs_human` and the tab's badge need."
        },
        "ReviewState": {
            "type": "object",
            "properties": {
                "swarm": {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/definitions/SwarmRecord"
                    },
                    "description": "By agent name, `review-<model-slug>`."
                },
                "draft": {
                    "type": "boolean",
                    "description": "True while `artifacts/review-draft.json` exists (s016); the tracker reads it."
                },
                "posted_url": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "The posted review's URL (s016), null until `post`."
                }
            },
            "required": [
                "swarm"
            ],
            "additionalProperties": false,
            "description": "The review swarm of a session (s015): the daemon writes it, `SessionView.review` reads it."
        },
        "SwarmRecord": {
            "type": "object",
            "properties": {
                "model": {
                    "type": "string",
                    "description": "`provider/model` the reviewer runs with."
                },
                "state": {
                    "$ref": "#/definitions/SwarmState"
                },
                "pr": {
                    "type": "string",
                    "description": "Repo key of `repos` whose PR the reviewer reads."
                },
                "error": {
                    "type": "string",
                    "description": "Why the reviewer is `failed` (s016): the start error, the last text, or the exit code."
                }
            },
            "required": [
                "model",
                "state",
                "pr"
            ],
            "additionalProperties": false,
            "description": "One reviewer of the swarm (s015), as `session.yaml` records it under `review.swarm`."
        },
        "SwarmState": {
            "type": "string",
            "enum": [
                "queued",
                "reading",
                "done",
                "failed"
            ],
            "description": "A reviewer's state (s015, s016). `done`: its verdict is in `artifacts/reviews/` and its pi is stopped. `failed`: it settled without a `VERDICT:` block, or exited."
        },
        "DesignState": {
            "type": "object",
            "properties": {
                "track": {
                    "$ref": "#/definitions/DesignTrack"
                },
                "stage": {
                    "$ref": "#/definitions/DesignStage"
                },
                "needs": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "The derived `needs_human` text of the design stage, or null."
                },
                "waiting": {
                    "type": "boolean",
                    "description": "True when the lead settled on a question."
                },
                "doc": {
                    "type": "string",
                    "description": "Repo-relative path of the design doc; absent until the lead calls `design_doc`."
                },
                "repo": {
                    "type": "string",
                    "description": "Repo key of the doc."
                },
                "review_run": {
                    "$ref": "#/definitions/DesignReviewRun"
                },
                "gate": {
                    "$ref": "#/definitions/DesignGate"
                },
                "approved": {
                    "$ref": "#/definitions/DesignApproval"
                },
                "approvals": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/DesignApproval"
                    },
                    "description": "Every approval, oldest first; at most `DESIGN_APPROVALS_MAX`."
                },
                "changed_after_approval": {
                    "type": "boolean",
                    "description": "True when the doc changed after the approval: the approval is invalidated."
                }
            },
            "required": [
                "track"
            ],
            "additionalProperties": false,
            "description": "The `design` block of `session.yaml`. `stage`, `needs` and `waiting` are derived."
        },
        "DesignTrack": {
            "type": "string",
            "enum": [
                "design",
                "direct"
            ]
        },
        "DesignStage": {
            "type": "string",
            "enum": [
                "intake",
                "brainstorm",
                "drafting",
                "drafted",
                "design-review",
                "resolving",
                "design-ready",
                "approved"
            ]
        },
        "DesignReviewRun": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "preset": {
                    "anyOf": [
                        {
                            "$ref": "#/definitions/ReviewPreset"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "started": {
                    "type": "string",
                    "description": "ISO 8601 start time."
                }
            },
            "required": [
                "id",
                "preset",
                "started"
            ],
            "additionalProperties": false,
            "description": "The review run that the app started (build session 3). Ids are `r1`, `r2`, …"
        },
        "ReviewPreset": {
            "type": "string",
            "enum": [
                "interactive",
                "uninterrupted",
                "feature_spec",
                "implementation"
            ]
        },
        "DesignGate": {
            "type": "object",
            "properties": {
                "question": {
                    "type": "string"
                },
                "options": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "asked": {
                    "type": "string",
                    "description": "ISO 8601 time the lead asked."
                }
            },
            "required": [
                "question",
                "options",
                "asked"
            ],
            "additionalProperties": false,
            "description": "An open gate: the one question the lead asked through `ask_question` (build session 3)."
        },
        "DesignApproval": {
            "type": "object",
            "properties": {
                "path": {
                    "type": "string",
                    "description": "Repo-relative path of the doc."
                },
                "repo": {
                    "type": "string",
                    "description": "Repo key of the doc."
                },
                "sha256": {
                    "type": "string"
                },
                "at": {
                    "type": "string",
                    "description": "ISO 8601 time of the approval."
                },
                "blockers": {
                    "type": "number",
                    "description": "The blockers the newest report listed when the operator approved."
                },
                "round": {
                    "type": "number",
                    "description": "The session round the approval belongs to."
                }
            },
            "required": [
                "path",
                "repo",
                "sha256",
                "at",
                "blockers",
                "round"
            ],
            "additionalProperties": false,
            "description": "One approval of the design doc. `sha256` is the normalized hash (T7)."
        },
        "RoundRecord": {
            "type": "object",
            "properties": {
                "round": {
                    "type": "number"
                },
                "branch": {
                    "type": "string"
                },
                "prs": {
                    "type": "array",
