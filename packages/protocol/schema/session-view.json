{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$ref": "#/definitions/SessionView",
    "definitions": {
        "SessionView": {
            "type": "object",
            "properties": {
                "summary": {
                    "$ref": "#/definitions/SessionSummary"
                },
                "board": {
                    "anyOf": [
                        {
                            "$ref": "#/definitions/BoardView"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "Null when the session has no PR yet; the stage is then in `summary.session.stage`."
                },
                "stack": {
                    "$ref": "#/definitions/StackView"
                },
                "agents_running": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Names of agents whose pi process the daemon currently hosts."
                },
                "can_verify": {
                    "type": "boolean",
                    "description": "True while the stack is up: the operator can test and tick `verify`."
                }
            },
            "required": [
                "summary",
                "board",
                "stack",
                "agents_running",
                "can_verify"
            ],
            "additionalProperties": false,
            "description": "Everything the UI renders for one session. `GET /sessions` returns one per session and `session.updated` carries a fresh one on every change, so the UI never polls."
        },
        "SessionSummary": {
            "type": "object",
            "properties": {
                "dir": {
                    "type": "string",
                    "description": "Directory name under `~/.spinner/sessions`, for example `s17-refund-flow`."
                },
                "path": {
                    "type": "string",
                    "description": "Absolute path of the session directory."
                },
                "session": {
                    "$ref": "#/definitions/Session"
                }
            },
            "required": [
                "dir",
                "path",
                "session"
            ],
            "additionalProperties": false,
            "description": "What the daemon reports about a session: the parsed file plus where it lives."
        },
        "Session": {
            "type": "object",
            "properties": {
                "version": {
                    "type": "number",
                    "const": 1
                },
                "id": {
                    "type": "string",
                    "description": "Short id, for example `s17`."
                },
                "slug": {
                    "type": "string",
                    "description": "URL-safe slug; the directory is `<id>-<slug>`."
                },
                "title": {
                    "type": "string"
                },
                "project": {
                    "type": "string",
                    "description": "Project name whose `spinner.yaml` configures the stack and the pipeline tracker."
                },
                "created": {
                    "type": "string",
                    "description": "ISO 8601 date or timestamp."
                },
                "stage": {
                    "$ref": "#/definitions/Stage"
                },
                "needs_human": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "The single next action for the operator, or null."
                },
                "branch": {
                    "type": "string"
                },
                "base": {
                    "type": "string"
                },
                "round": {
                    "type": "number",
                    "description": "Round number; 1 until the first `spinner reset`. Absent in files written before s005."
                },
                "repos": {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/definitions/SessionRepo"
                    }
                },
                "pipeline": {
                    "$ref": "#/definitions/Pipeline"
                },
                "stack": {
                    "$ref": "#/definitions/StackState"
                },
                "agents": {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/definitions/AgentSpec"
                    }
                }
            },
            "required": [
                "version",
                "id",
                "slug",
                "title",
                "created",
                "stage",
                "needs_human",
                "branch",
                "base",
                "repos",
                "stack",
                "agents"
            ],
            "additionalProperties": false,
            "description": "The whole of `session.yaml`."
        },
        "Stage": {
            "type": "string",
            "enum": [
                "planned",
                "building",
                "bot-review",
                "fixing",
                "verifying",
                "peer-review",
                "addressing",
                "approving",
                "queued",
                "merged",
                "closed"
            ]
        },
        "SessionRepo": {
            "type": "object",
            "properties": {
                "path": {
                    "type": "string",
                    "description": "Path of the repo on this machine. May start with `~` or be relative to the session."
                },
                "worktree": {
                    "type": "string",
                    "description": "Worktree path relative to the session directory. Absent for the bootstrap session."
                },
                "changed": {
                    "type": "boolean",
                    "description": "True when the session's branch has commits ahead of `base` in this repo."
                },
                "pr": {
                    "anyOf": [
                        {
                            "$ref": "#/definitions/PullRequest"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "The PR for this repo, or null when none has been opened."
                }
            },
            "required": [
                "path",
                "changed"
            ],
            "additionalProperties": false
        },
        "PullRequest": {
            "type": "object",
            "properties": {
                "number": {
                    "type": "number"
                },
                "url": {
                    "type": "string"
                },
                "author": {
                    "type": "string"
                },
                "state": {
                    "$ref": "#/definitions/PrState"
                },
                "head": {
                    "type": "string"
                },
                "checks": {
                    "$ref": "#/definitions/CheckState"
                },
                "approval_check": {
                    "$ref": "#/definitions/ApprovalCheckState"
                },
                "approvals": {
                    "$ref": "#/definitions/PrApprovals"
                },
                "threads": {
                    "$ref": "#/definitions/PrThreads"
                },
                "review": {
                    "$ref": "#/definitions/ReviewDecision"
                },
                "bot_reviewed_head": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Head SHA of the latest bot review, or null before the first one."
                },
                "queue": {
                    "$ref": "#/definitions/QueueState"
                },
                "queue_reason": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Why the merge queue removed the PR, from `RemovedFromMergeQueueEvent.reason`."
                },
                "last_activity": {
                    "type": "string",
                    "description": "ISO 8601 timestamp of the last activity on the PR."
                },
                "title": {
                    "type": "string",
                    "description": "PR title, as `gh pr create` set it or GitHub reports it. Absent before s005."
                }
            },
            "required": [
                "number",
                "url",
                "author",
                "state",
                "head",
                "checks",
                "approval_check",
                "approvals",
                "threads",
                "review",
                "bot_reviewed_head",
                "queue",
                "last_activity"
            ],
            "additionalProperties": false
        },
        "PrState": {
            "type": "string",
            "enum": [
                "draft",
                "open",
                "merged",
                "closed"
            ]
        },
        "CheckState": {
            "type": "string",
            "enum": [
                "pending",
                "green",
                "red"
            ]
        },
        "ApprovalCheckState": {
            "type": "string",
            "enum": [
                "pending",
                "pass",
                "fail"
            ]
        },
        "PrApprovals": {
            "type": "object",
            "properties": {
                "required": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/ApprovalRole"
                    }
                },
                "peer": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Logins of peers who approved the current head."
                },
                "owner": {
                    "type": "boolean",
                    "description": "Whether the owner (the person named in `github.owner_login`) approved the current head."
                }
            },
            "required": [
                "required",
                "peer",
                "owner"
            ],
            "additionalProperties": false
        },
        "ApprovalRole": {
            "type": "string",
            "enum": [
                "peer",
                "owner"
            ]
        },
        "PrThreads": {
            "type": "object",
            "properties": {
                "bots_open": {
                    "type": "number"
                },
                "humans_open": {
                    "type": "number"
                },
                "resolved": {
                    "type": "number"
                },
                "flagged": {
                    "type": "number",
                    "description": "Open threads the fixer flagged for the operator. Absent in files written before s005."
                }
            },
            "required": [
                "bots_open",
                "humans_open",
                "resolved"
            ],
            "additionalProperties": false
        },
        "ReviewDecision": {
            "type": "string",
            "enum": [
                "none",
                "changes_requested",
                "approved"
            ]
        },
        "QueueState": {
            "type": "string",
            "enum": [
                "none",
                "queued",
                "popped",
                "merging"
            ]
        },
        "Pipeline": {
            "type": "object",
            "properties": {
                "verified_locally": {
                    "type": "boolean"
                },
                "verified_heads": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    },
                    "description": "Repo name to head SHA that the operator verified."
                },
                "verified_at": {
                    "type": "string",
                    "description": "When and by whom `spinner verify` recorded the tick. Absent until the first tick."
                },
                "verified_by": {
                    "type": "string"
                },
                "slack_post": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "reviewer": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "posted_at": {
                    "type": "string",
                    "description": "When `spinner post` sent the message. Absent until then."
                },
                "approved_heads": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    },
                    "description": "Repo name to head SHA the operator approved through `spinner approve`."
                },
                "slack_activity": {
                    "$ref": "#/definitions/SlackActivity",
                    "description": "Replies and reactions under the Slack post, as the daemon last polled them."
                }
            },
            "required": [
                "verified_locally",
                "slack_post"
            ],
            "additionalProperties": false,
            "description": "Pipeline facts. Hand-written files may omit `verified_heads` and `reviewer`; the daemon treats an absent field as empty and fills it in when it first writes the file."
        },
        "SlackActivity": {
            "type": "object",
            "properties": {
                "replies": {
                    "type": "number"
                },
                "reactions": {
                    "type": "number"
                },
                "last_activity": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "ISO 8601 time of the latest reply or reaction, or null when there is none."
                },
                "polled_at": {
                    "type": "string",
                    "description": "ISO 8601 time of the poll that produced these counts."
                }
            },
            "required": [
                "replies",
                "reactions",
                "last_activity",
                "polled_at"
            ],
            "additionalProperties": false,
            "description": "What the daemon reads under the session's Slack post. Read-only; counts drive the board."
        },
        "StackState": {
            "type": "object",
            "properties": {
                "project": {
                    "type": "string",
                    "description": "Docker compose project name, for example `spinner-s17`."
                },
                "state": {
                    "$ref": "#/definitions/StackStateName"
                },
                "hosts": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    },
                    "description": "Service name to hostname, for example `admin` to `admin.s17.localhost`."
                },
                "db": {
                    "type": "string",
                    "description": "Database name cloned from the seed template."
                },
                "db_stale": {
                    "type": "boolean",
                    "description": "The clone belongs to a previous round: `reset` ran while the stack was down and did not touch the server. The next `up` drops it before it clones."
                },
                "processes": {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/definitions/HostProcess"
                    },
                    "description": "Services with `runtime: host`, by name: the process Spinner started for them."
                }
            },
            "required": [
                "state"
            ],
            "additionalProperties": false
        },
        "StackStateName": {
            "type": "string",
            "enum": [
                "none",
                "up",
                "down",
                "starting",
                "failed"
            ],
            "description": "Stack state, as the daemon observes it. `none` means the session has no stack."
        },
        "HostProcess": {
            "type": "object",
            "properties": {
                "pid": {
                    "type": "number"
                },
                "started": {
                    "type": "string",
                    "description": "The process start time as `ps` prints it. A pid is reused once its process exits; the start time tells Spinner's process from a stranger that inherited the number."
                },
                "port": {
                    "type": "number",
                    "description": "The port the service listens on; the proxy routes its hostname here."
                },
                "log": {
                    "type": "string",
                    "description": "Log file, relative to the session directory."
                }
            },
            "required": [
                "pid",
                "port",
                "log"
            ],
            "additionalProperties": false,
            "description": "A `runtime: host` service's process, as `spinner up` started it."
        },
        "AgentSpec": {
            "type": "object",
            "properties": {
                "harness": {
                    "$ref": "#/definitions/AgentHarnessName"
                },
                "model": {
                    "type": "string"
                },
                "process": {
                    "$ref": "#/definitions/AgentProcessState"
                },
                "pid": {
                    "type": "number"
                },
                "started": {
                    "type": "string",
                    "description": "The process start time as `ps -o lstart=` prints it, so a restart can tell a reused pid."
                }
            },
            "required": [
                "harness",
                "model",
                "process"
            ],
            "additionalProperties": false,
            "description": "One agent of a session: how it runs and whether its process is alive."
        },
        "AgentHarnessName": {
            "type": "string",
            "enum": [
                "tty",
                "rpc",
                "pi"
            ],
            "description": "How an agent's pi runs: `tty` is pi's own terminal UI in a pty, rendered by the agent tab over `GET /sessions/:dir/agents/:name/tty`; `rpc` is `pi --mode rpc`, the headless path. `pi` is the value files written before s009 carry; it reads as `rpc`."
        },
        "AgentProcessState": {
            "type": "string",
            "enum": [
                "running",
                "idle",
                "exited"
            ]
        },
        "BoardView": {
            "type": "object",
            "properties": {
                "stage": {
                    "$ref": "#/definitions/Stage"
                },
                "needs_human": {
                    "$ref": "#/definitions/NeedsHuman"
                },
                "stale": {
                    "type": "boolean",
                    "description": "True in peer-review when no reviewer activity happened for `stale_after_hours`."
                },
                "prs": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/PrFacts"
                    },
                    "description": "One entry per repo with a PR, in `session.yaml` order."
                }
            },
            "required": [
                "needs_human",
                "prs",
                "stage",
                "stale"
            ],
            "additionalProperties": false,
            "description": "The pipeline tracker's view of a session: the derived stage and the PR facts behind it."
        },
        "NeedsHuman": {
            "type": [
                "string",
                "null"
            ],
            "description": "The single next action for the operator, or null when nothing waits on them."
        },
        "PrFacts": {
            "type": "object",
            "properties": {
                "number": {
                    "type": "number"
                },
                "url": {
                    "type": "string"
                },
                "author": {
                    "type": "string"
                },
                "state": {
                    "$ref": "#/definitions/PrState"
                },
                "head": {
                    "type": "string"
                },
                "checks": {
                    "$ref": "#/definitions/CheckState"
                },
                "approval_check": {
                    "$ref": "#/definitions/ApprovalCheckState"
                },
                "approvals": {
                    "$ref": "#/definitions/PrApprovals"
                },
                "threads": {
                    "$ref": "#/definitions/PrThreads"
                },
                "review": {
                    "$ref": "#/definitions/ReviewDecision"
                },
                "bot_reviewed_head": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Head SHA of the latest bot review, or null before the first one."
                },
                "queue": {
                    "$ref": "#/definitions/QueueState"
                },
                "queue_reason": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Why the merge queue removed the PR, from `RemovedFromMergeQueueEvent.reason`."
                },
                "last_activity": {
                    "type": "string",
                    "description": "ISO 8601 timestamp of the last activity on the PR."
                },
                "title": {
                    "type": "string",
                    "description": "PR title, as `gh pr create` set it or GitHub reports it. Absent before s005."
                },
                "repo": {
                    "type": "string"
                }
            },
            "required": [
                "approval_check",
                "approvals",
                "author",
                "bot_reviewed_head",
                "checks",
                "head",
                "last_activity",
                "number",
                "queue",
                "repo",
                "review",
                "state",
                "threads",
                "url"
            ],
            "additionalProperties": false,
            "description": "Facts about one PR, as stored in `session.yaml`, plus the repo key they belong to."
        },
        "StackView": {
            "type": "object",
            "properties": {
                "state": {
                    "$ref": "#/definitions/StackStateName"
                },
                "project": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Docker compose project name, or null when the session has no stack."
                },
                "database": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Per-session database name, or null when the session has no stack."
                },
                "services": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/ServiceView"
                    },
                    "description": "Every service of the spec, in spec order. Empty when the session has no stack."
                },
                "observed": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "ISO 8601 time of the last docker observation, or null before the first one."
                }
            },
            "required": [
                "state",
                "project",
                "database",
                "services",
                "observed"
            ],
            "additionalProperties": false,
            "description": "Stack state assembled from `session.yaml` and the daemon's last docker observation."
        },
        "ServiceView": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "where": {
                    "$ref": "#/definitions/ServiceWhere"
                },
                "status": {
                    "$ref": "#/definitions/ServiceStatus"
                },
                "host": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "`<host>.<id>.localhost`, or null for an internal service."
                },
                "url": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Full URL of the service through the proxy, or null for an internal service."
                },
                "process": {
                    "anyOf": [
                        {
                            "$ref": "#/definitions/HostProcess"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "For `where: host`: the process `spinner up` started, while the stack is up."
                },
                "preview": {
                    "$ref": "#/definitions/PreviewMode",
                    "description": "`services.<name>.preview` of the spec, `frame` when the spec leaves it out."
                }
            },
            "required": [
                "name",
                "where",
                "status",
                "host",
                "url",
                "process",
                "preview"
            ],
            "additionalProperties": false
        },
        "ServiceWhere": {
            "type": "string",
            "enum": [
                "container",
                "host"
            ],
            "description": "Where a service runs."
        },
        "ServiceStatus": {
            "type": "string",
            "enum": [
                "starting",
                "healthy",
                "unhealthy",
                "stopped",
                "unknown"
            ],
            "description": "A service's health as the daemon last observed it. `unknown` is a service with no healthcheck that is running; `stopped` covers a stack that is down or a missing container."
        },
        "PreviewMode": {
            "type": "string",
            "enum": [
                "frame",
                "top-level"
            ],
            "description": "How the UI embeds the service's preview. `frame` (the default) is an iframe. `top-level` marks an app that needs its own top-level page, for example one whose login cookie is `SameSite=Lax`: the desktop app shows it in a `WebContentsView`, and the browser UI keeps the iframe but tells the operator to open it in a tab."
        }
    },
    "$id": "https://spinner.dev/schema/session-view.json",
    "title": "Spinner SessionView (GET /sessions, session.updated)"
}
