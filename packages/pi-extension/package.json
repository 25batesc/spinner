        "@spinner/protocol": "workspace:*"
    },
    "peerDependencies": {
        "typebox": "*"
    },
    "devDependencies": {
        "@types/node": "^24.0.0",
        "typebox": "1.3.27",
        "typescript": "^5.9.0",
        "vitest": "^3.2.0"
    }
