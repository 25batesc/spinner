{
    "name": "@spinner/daemon",
    "version": "0.30.2",
    "private": true,
    "description": "spinnerd: the local daemon that watches sessions and serves the API.",
    "license": "MIT",
    "type": "module",
    "bin": {
        "spinnerd": "./dist/main.js"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "start": "node dist/main.js",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@hono/node-server": "^2.1.5",
        "@spinner/protocol": "workspace:*",
        "chokidar": "^6.0.0",
        "hono": "^4.13.14",
        "node-pty": "^1.1.0",
        "pg": "^8.23.1",
        "ws": "^8.22.0",
        "yaml": "^2.9.1"
    },
    "devDependencies": {
        "@types/node": "^24.0.0",
        "@types/pg": "^8.23.1",
        "@types/ws": "^8.18.2",
        "typescript": "^5.9.0",
        "vitest": "^3.2.0"
    }
}
