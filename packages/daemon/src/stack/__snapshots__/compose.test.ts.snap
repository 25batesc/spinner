// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`render_compose on examples/sample-stack > matches the snapshot 1`] = `
"# Generated by spinner from spinner.yaml. Do not edit; edit the spec.
name: spinner-s17
services:
  api:
    image: spinner/sample-api-dev
    working_dir: /app/examples/sample-stack/api
    command:
      - sh
      - -c
      - if [ ! -f node_modules/.spinner-ready ]; then npm ci && touch node_modules/.spinner-ready; fi && exec node --watch server.js
    environment:
      DATABASE_URL: postgres://postgres:postgres@postgres:5432/spinner_s17
      SESSION_ID: s17
    volumes:
      - /home/me/.spinner/sessions/s17-try-it/worktrees/app:/app
      - spinner-deps-npm-cache-0123456789ab:/app/examples/sample-stack/api/node_modules
    healthcheck:
      test:
        - CMD
        - node
        - -e
        - fetch('http://127.0.0.1:3000/health').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))
      interval: 2s
      timeout: 3s
      retries: 30
      start_period: 60s
      start_interval: 250ms
    depends_on:
      temporal:
        condition: service_started
    labels:
      traefik.enable: "true"
      traefik.docker.network: spinner-s17
      traefik.http.routers.spinner-s17-api.rule: Host(\`api.s17.localhost\`)
      traefik.http.routers.spinner-s17-api.entrypoints: web
      traefik.http.services.spinner-s17-api.loadbalancer.server.port: "3000"
  web:
    image: spinner/sample-api-dev
    working_dir: /app/examples/sample-stack/web
    command: node --watch server.js
    environment:
      API_URL: http://api:3000
      SESSION_ID: s17
      PUBLIC_API_URL: http://api.s17.localhost
    volumes:
      - /home/me/.spinner/sessions/s17-try-it/worktrees/app:/app
    healthcheck:
      test:
        - CMD
        - node
        - -e
        - fetch('http://127.0.0.1:8080/').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))
      interval: 2s
      timeout: 3s
      retries: 30
      start_period: 60s
      start_interval: 250ms
    depends_on:
      api:
        condition: service_healthy
    labels:
      traefik.enable: "true"
      traefik.docker.network: spinner-s17
      traefik.http.routers.spinner-s17-web.rule: Host(\`web.s17.localhost\`)
      traefik.http.routers.spinner-s17-web.entrypoints: web
      traefik.http.services.spinner-s17-web.loadbalancer.server.port: "8080"
  temporal:
    image: temporalio/temporal:1.6.1
    command: server start-dev --ip 0.0.0.0 --log-level warn --db-filename /home/temporal/temporal.db
    volumes:
      - temporal-data:/home/temporal
    labels:
      traefik.enable: "true"
      traefik.docker.network: spinner-s17
      traefik.http.routers.spinner-s17-temporal.rule: Host(\`temporal.s17.localhost\`)
      traefik.http.routers.spinner-s17-temporal.entrypoints: web
      traefik.http.services.spinner-s17-temporal.loadbalancer.server.port: "8233"
      traefik.http.middlewares.spinner-s17-temporal-frames.headers.customresponseheaders.X-Frame-Options: ""
      traefik.http.middlewares.spinner-s17-temporal-frames.headers.customresponseheaders.Content-Security-Policy: ""
      traefik.http.routers.spinner-s17-temporal.middlewares: spinner-s17-temporal-frames
networks:
  default:
    name: spinner-s17
    external: true
volumes:
  spinner-deps-npm-cache-0123456789ab:
    name: spinner-deps-npm-cache-0123456789ab
    external: true
  temporal-data: {}
"
`;

exports[`render_compose on examples/sample-stack > matches the snapshot 2`] = `
"COMPOSE_PROJECT_NAME=spinner-s17
SESSION_ID=s17
SESSION_DB=spinner_s17
SESSION_BRANCH=feat/try-it
SESSION_DIR=/home/me/.spinner/sessions/s17-try-it
"
`;
