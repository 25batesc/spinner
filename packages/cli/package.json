{
    "name": "@spinner/cli",
    "version": "0.10.0",
    "private": true,
    "description": "spinner: the command-line client for Spinner sessions.",
    "license": "MIT",
    "type": "module",
    "bin": {
        "spinner": "./dist/main.js"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "scripts": {
        "build": "tsc -p tsconfig.json && chmod +x dist/main.js",
        "start": "node dist/main.js",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@spinner/daemon": "workspace:*",
        "@spinner/protocol": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^24.0.0",
        "typescript": "^5.9.0",
        "vitest": "^3.2.0"
    }
}
