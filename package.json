{
    "name": "spinner-monorepo",
    "private": true,
    "version": "0.25.2",
    "description": "Spinner: a local daemon, CLI and web UI for running agent sessions.",
    "license": "MIT",
    "packageManager": "pnpm@10.28.2",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "build": "pnpm -r build",
        "test": "pnpm -r test",
        "lint": "eslint .",
        "typecheck": "pnpm -r typecheck",
        "daemon": "pnpm --filter @spinner/daemon start",
        "spinner": "node packages/cli/dist/main.js",
        "desktop": "pnpm --filter @spinner/desktop build && pnpm --filter @spinner/desktop start",
        "desktop:build": "pnpm --filter @spinner/desktop build && pnpm --filter @spinner/desktop package"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.0",
        "@types/node": "^24.0.0",
        "eslint": "^9.39.0",
        "typescript": "^5.9.0",
        "typescript-eslint": "^8.46.0",
        "vitest": "^3.2.0"
    }
}
